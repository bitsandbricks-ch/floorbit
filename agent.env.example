# Settings for the local agent (docker-compose.agent.yml, docs/agent.md). Copy to agent.env.
# Keep agent.env readable only by you: it holds the agent key.

# The hosted Floorbit, and the key from its Settings > Local agents (shown once when enrolling).
FLOORBIT_URL=https://floor.example.com
FLOORBIT_AGENT_KEY=

# Everything else is set up in Floorbit, Settings > Plugins, and the agent takes it from there:
# LibreNMS, NetBox, health checks, syslog and NetFlow from the hall, the attendees' front door.
# For syslog, flows or the front door, also publish their ports in docker-compose.agent.yml.

# Optional: a certificate for the front door and telemetry, so they answer with HTTPS.
#FLOORBIT_AGENT_TLS_CERT=/certs/agent.pem
#FLOORBIT_AGENT_TLS_KEY=/certs/agent.key
