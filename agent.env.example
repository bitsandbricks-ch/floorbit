# Settings for the local agent (docker-compose.agent.yml, docs/agent.md). Copy to agent.env.
# Keep agent.env readable only by you: it holds the agent key and the LibreNMS and NetBox tokens.

# The hosted Floorbit, and the key from its Settings > Local agents (shown once when enrolling).
FLOORBIT_URL=https://floor.example.com
FLOORBIT_AGENT_KEY=

# The event's LibreNMS: switch status, ports, ARP.
LIBRENMS_URL=https://librenms.example.com
LIBRENMS_TOKEN=

# Optional: the event's NetBox, for the inventory.
#NETBOX_URL=https://netbox.example.com
#NETBOX_TOKEN=

# Optional: health checks from inside the hall, for the hosted health wall.
#FLOORBIT_AGENT_PLUGINS=http-check
#FLOORBIT_PLUGIN_HTTP_CHECK_TARGETS=Cache=http://cache.lan.example/health,Panel=http://panel.lan.example/
