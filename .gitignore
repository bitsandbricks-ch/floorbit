# Secrets and agents' local state
*.pem
*.key
.claude/settings.local.json

# The React app, built by `npm run build` in frontend/
static/app/
frontend/node_modules

# The documentation site (mkdocs build)
/site/

# A local valkey-server or redis-server started inside the repo writes its snapshot here. It can
# hold live cache data, so it never goes into git.
dump.rdb
*.rdb
# Check-in state a local run (FLOORBIT_DEMO=1) writes next to app.py.
/checkins-history.jsonl
/seat_ports.json
agent.env
*.json.next

# Signed agent plugin bundles: built by the release workflow, never committed.
agent-bundles/*
!agent-bundles/.gitkeep

# Written by the telemetry collector (Settings > Telemetry), never committed.
telegraf/

# pytest-cov data
.coverage
.coverage.*
