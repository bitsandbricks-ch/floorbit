# Copy to .env and fill in what you need (docs/install.md). docker compose reads it; so does
# `flask --app app run` outside Docker. Every line is optional: with none of them Floorbit runs as a
# plain floor plan editor. Leave a URL or token empty to turn that integration off.

# Docker Compose
FLOORBIT_PORT=8080                    # where Floorbit answers on this machine
FLOORBIT_VERSION=latest               # image tag: latest (master) or a release such as 1.4.0

NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=
NETBOX_DEVICE_ROLE=access-switch      # comma separated device role slugs
NETBOX_VERIFY_SSL=true

LIBRENMS_URL=https://librenms.example.com
LIBRENMS_TOKEN=
LIBRENMS_VERIFY_SSL=true

REDIS_HOST=localhost                  # outside Docker; compose always uses its own redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_ARP=300                     # seconds
CACHE_TTL_MAC=300
MONITORING_CACHE_FILE=                # last good LibreNMS data without Redis (docs/offline.md); default next to data.json

# Look (docs/themes.md). Settings > Appearance overrides these and takes colours and a logo.
FLOORBIT_THEME=floorbit               # floorbit, ops, kiosk, classic or custom
FLOORBIT_EVENT_NAME=

# Sign-in (docs/auth.md). The first account (an admin) is created from these when none exists yet;
# remove the password from here once you have signed in. Manage accounts with
# `docker compose exec floorbit flask users ...`.
SECRET_KEY=                           # long random string; generated and kept in data.json if empty
AUTH_ADMIN_USER=
AUTH_ADMIN_PASSWORD=
AUTH_PUBLIC_READ=true                 # read-only API without signing in (kiosk screens)
# OIDC sign-in providers are added under Settings > Sign-in providers; their client secrets only
# ever come from here (or a Docker secret file), one per provider ID:
# OIDC_AUTHENTIK_CLIENT_SECRET=
# OIDC_AUTHENTIK_CLIENT_SECRET_FILE=/run/secrets/oidc_authentik

# Demo mode (docs/demo.md): a made-up hall with players and traffic, no network needed.
FLOORBIT_DEMO=                        # 1 to turn it on; every page then says "Demo data"
