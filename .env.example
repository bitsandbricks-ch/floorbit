# Copy to .env and fill in. docker compose reads .env on its own; `python app.py` loads it too.
# Leave a URL or token empty to turn that integration off.

NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=
NETBOX_DEVICE_ROLE=access-switch      # comma separated device role slugs
NETBOX_VERIFY_SSL=true

LIBRENMS_URL=https://librenms.example.com
LIBRENMS_TOKEN=
LIBRENMS_VERIFY_SSL=true

REDIS_HOST=redis                      # localhost when you run app.py outside compose
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_ARP=300                     # seconds
CACHE_TTL_MAC=300
