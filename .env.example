# Copy to .env and fill in. docker compose reads .env on its own; `python app.py` loads it too.
# Leave a URL or token empty to turn that integration off.

NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=
NETBOX_DEVICE_ROLE=access-switch      # comma separated device role slugs
NETBOX_VERIFY_SSL=true

LIBRENMS_URL=https://librenms.example.com
LIBRENMS_TOKEN=
LIBRENMS_VERIFY_SSL=true

REDIS_HOST=redis                      # localhost when you run app.py outside compose
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_ARP=300                     # seconds
CACHE_TTL_MAC=300
MONITORING_CACHE_FILE=                # last good LibreNMS data without Redis (docs/offline.md); default next to data.json

# Look (docs/themes.md). Settings > Appearance overrides these and takes colours and a logo.
FLOORBIT_THEME=floorbit               # floorbit, ops, kiosk, classic or custom
FLOORBIT_EVENT_NAME=

# Sign-in (docs/auth.md). The first account is created from these when none exists yet;
# after that, manage accounts with `docker compose exec lal-app flask users ...`.
SECRET_KEY=                           # long random string; generated and kept in data.json if empty
AUTH_ADMIN_USER=
AUTH_ADMIN_PASSWORD=
AUTH_PUBLIC_READ=true                 # read-only API without signing in (kiosk screens)

# Demo mode (docs/demo.md): a made-up hall with players and traffic, no network needed.
FLOORBIT_DEMO=                        # 1 to turn it on; every page then says "Demo data"
